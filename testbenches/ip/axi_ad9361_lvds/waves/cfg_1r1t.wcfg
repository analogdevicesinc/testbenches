<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="system_tb_behav.wdb" id="1">
         <top_modules>
            <top_module name="adi_api_pkg" />
            <top_module name="adi_axi_agent_pkg" />
            <top_module name="adi_axi_monitor_pkg" />
            <top_module name="adi_common_pkg" />
            <top_module name="adi_environment_pkg" />
            <top_module name="adi_vip_pkg" />
            <top_module name="attributes" />
            <top_module name="axi_vip_pkg" />
            <top_module name="glbl" />
            <top_module name="io_vip_if_base_pkg" />
            <top_module name="ipif_pkg" />
            <top_module name="irq_handler_pkg" />
            <top_module name="logger_pkg" />
            <top_module name="m_axi_sequencer_pkg" />
            <top_module name="math_real" />
            <top_module name="numeric_std" />
            <top_module name="pub_sub_pkg" />
            <top_module name="s_axi_sequencer_pkg" />
            <top_module name="standard" />
            <top_module name="std" />
            <top_module name="std_logic_1164" />
            <top_module name="std_logic_arith" />
            <top_module name="std_logic_misc" />
            <top_module name="std_logic_unsigned" />
            <top_module name="system_tb" />
            <top_module name="test_harness_env_pkg" />
            <top_module name="textio" />
            <top_module name="vcomponents" />
            <top_module name="vip_agent_typedef_pkg" />
            <top_module name="vital_primitives" />
            <top_module name="vital_timing" />
            <top_module name="vpkg" />
            <top_module name="watchdog_pkg" />
            <top_module name="xil_common_vip_pkg" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="2.000000 us"></ZoomStartTime>
      <ZoomEndTime time="10.200000 us"></ZoomEndTime>
      <Cursor1Time time="2.262000 us"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="310"></NameColumnWidth>
      <ValueColumnWidth column_width="100"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="60" />

   <!-- ================================================================ -->
   <!-- Clock                                                             -->
   <!-- ================================================================ -->
   <wvobject fp_name="divider_clk" type="divider">
      <obj_property name="label">Clock (250 MHz l_clk)</obj_property>
      <obj_property name="DisplayName">label</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/system_tb/test_harness/dut/inst/clk">
      <obj_property name="ElementShortName">clk</obj_property>
      <obj_property name="ObjectShortName">clk</obj_property>
   </wvobject>

   <!-- ================================================================ -->
   <!-- SECTION 1 divider                                                -->
   <!-- ================================================================ -->
   <wvobject fp_name="divider_sec1" type="divider">
      <obj_property name="label">── SECTION 1: Valid steady-state patterns (2.262–7.182 us) ──</obj_property>
      <obj_property name="DisplayName">label</obj_property>
   </wvobject>

   <!-- ================================================================ -->
   <!-- RX Physical Interface (LVDS pins — driven by io_vip)            -->
   <!-- ================================================================ -->
   <wvobject fp_name="divider_rx_phys" type="divider">
      <obj_property name="label">RX Physical (LVDS pins)</obj_property>
      <obj_property name="DisplayName">label</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/system_tb/test_harness/dut/inst/rx_frame_in_p">
      <obj_property name="ElementShortName">rx_frame_in_p  [driven by rx_frame_vip]</obj_property>
      <obj_property name="ObjectShortName">rx_frame_in_p  [driven by rx_frame_vip]</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/system_tb/test_harness/dut/inst/rx_data_in_p">
      <obj_property name="ElementShortName">rx_data_in_p[5:0]  [driven by rx_data_vip]</obj_property>
      <obj_property name="ObjectShortName">rx_data_in_p[5:0]  [driven by rx_data_vip]</obj_property>
      <obj_property name="Radix">HEXRADIX</obj_property>
   </wvobject>

   <!-- ================================================================ -->
   <!-- RX Captured: post-IBUFDS + IDELAYE3 + IDDRE1                   -->
   <!-- rx_frame_s[1]=posedge capture, rx_frame_s[0]=negedge capture   -->
   <!-- rx_frame = rx_frame_s delayed one posedge (previous DDR cycle)  -->
   <!-- ================================================================ -->
   <wvobject fp_name="divider_rx_cap" type="divider">
      <obj_property name="label">RX Captured (post-IDDRE1, inside axi_ad9361_lvds_if)</obj_property>
      <obj_property name="DisplayName">label</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/system_tb/test_harness/dut/inst/genblk2/i_dev_if/rx_frame_s">
      <obj_property name="ElementShortName">rx_frame_s[1:0]  [1]=posedge [0]=negedge</obj_property>
      <obj_property name="ObjectShortName">rx_frame_s[1:0]  [1]=posedge [0]=negedge</obj_property>
      <obj_property name="Radix">BINRADIX</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/system_tb/test_harness/dut/inst/genblk2/i_dev_if/rx_frame">
      <obj_property name="ElementShortName">rx_frame[1:0]    (previous DDR cycle)</obj_property>
      <obj_property name="ObjectShortName">rx_frame[1:0]    (previous DDR cycle)</obj_property>
      <obj_property name="Radix">BINRADIX</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/system_tb/test_harness/dut/inst/genblk2/i_dev_if/rx_data_1_s">
      <obj_property name="ElementShortName">rx_data_1_s[5:0] (posedge: I channel)</obj_property>
      <obj_property name="ObjectShortName">rx_data_1_s[5:0] (posedge: I channel)</obj_property>
      <obj_property name="Radix">HEXRADIX</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/system_tb/test_harness/dut/inst/genblk2/i_dev_if/rx_data_0_s">
      <obj_property name="ElementShortName">rx_data_0_s[5:0] (negedge: Q channel)</obj_property>
      <obj_property name="ObjectShortName">rx_data_0_s[5:0] (negedge: Q channel)</obj_property>
      <obj_property name="Radix">HEXRADIX</obj_property>
   </wvobject>

   <!-- ================================================================ -->
   <!-- Frame Error Detection                                            -->
   <!-- {rx_frame_s, rx_frame} whitelist: 1111/1100/0000/0011 → ok     -->
   <!-- Any other pattern → rx_error=1 → adc_status_p=0                -->
   <!-- ================================================================ -->
   <wvobject fp_name="divider_frame" type="divider">
      <obj_property name="label">Frame Error Detection</obj_property>
      <obj_property name="DisplayName">label</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/system_tb/test_harness/dut/inst/genblk2/i_dev_if/rx_error">
      <obj_property name="ElementShortName">rx_error         (1 = invalid frame pattern)</obj_property>
      <obj_property name="ObjectShortName">rx_error         (1 = invalid frame pattern)</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/system_tb/test_harness/dut/inst/genblk2/i_dev_if/rx_locked">
      <obj_property name="ElementShortName">rx_locked        (IDELAYCTRL locked)</obj_property>
      <obj_property name="ObjectShortName">rx_locked        (IDELAYCTRL locked)</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/system_tb/test_harness/dut/inst/genblk2/i_dev_if/adc_status_p">
      <obj_property name="ElementShortName">adc_status_p     (~rx_error &amp; rx_locked → 1=OK)</obj_property>
      <obj_property name="ObjectShortName">adc_status_p     (~rx_error &amp; rx_locked → 1=OK)</obj_property>
   </wvobject>

   <!-- ================================================================ -->
   <!-- RX Delineation (1R1T FSM)                                       -->
   <!-- frame=0011 (curr=00, prev=11) → store all words, valid=1 (pulse)-->
   <!-- ================================================================ -->
   <wvobject fp_name="divider_rx_delin" type="divider">
      <obj_property name="label">RX Delineation FSM (1R1T)</obj_property>
      <obj_property name="DisplayName">label</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/system_tb/test_harness/dut/inst/genblk2/i_dev_if/adc_valid_p">
      <obj_property name="ElementShortName">adc_valid_p      (1-cycle pulse on frame=0011)</obj_property>
      <obj_property name="ObjectShortName">adc_valid_p      (1-cycle pulse on frame=0011)</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/system_tb/test_harness/dut/inst/genblk2/i_dev_if/adc_data_p">
      <obj_property name="ElementShortName">adc_data_p[47:0] [47:24]=0 [23:0]=sample</obj_property>
      <obj_property name="ObjectShortName">adc_data_p[47:0] [47:24]=0 [23:0]=sample</obj_property>
      <obj_property name="Radix">HEXRADIX</obj_property>
   </wvobject>

   <!-- ================================================================ -->
   <!-- SECTION 2 divider                                                -->
   <!-- ================================================================ -->
   <wvobject fp_name="divider_sec2" type="divider">
      <obj_property name="label">── SECTION 2: Complete 1R1T frame bursts (7.182–7.326 us) ──</obj_property>
      <obj_property name="DisplayName">label</obj_property>
   </wvobject>

   <!-- ================================================================ -->
   <!-- ADC Outputs: DUT top-level → DMA side (8 pipeline stages deep) -->
   <!-- ================================================================ -->
   <wvobject fp_name="divider_adc_out" type="divider">
      <obj_property name="label">ADC Outputs (DMA side, 8 clk cycles after adc_valid_p)</obj_property>
      <obj_property name="DisplayName">label</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/system_tb/test_harness/dut/inst/adc_valid_i0">
      <obj_property name="ElementShortName">adc_valid_i0     (R1 I-channel valid)</obj_property>
      <obj_property name="ObjectShortName">adc_valid_i0     (R1 I-channel valid)</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/system_tb/test_harness/dut/inst/adc_data_i0">
      <obj_property name="ElementShortName">adc_data_i0[15:0]</obj_property>
      <obj_property name="ObjectShortName">adc_data_i0[15:0]</obj_property>
      <obj_property name="Radix">HEXRADIX</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/system_tb/test_harness/dut/inst/adc_valid_q0">
      <obj_property name="ElementShortName">adc_valid_q0     (R1 Q-channel valid)</obj_property>
      <obj_property name="ObjectShortName">adc_valid_q0     (R1 Q-channel valid)</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/system_tb/test_harness/dut/inst/adc_data_q0">
      <obj_property name="ElementShortName">adc_data_q0[15:0]</obj_property>
      <obj_property name="ObjectShortName">adc_data_q0[15:0]</obj_property>
      <obj_property name="Radix">HEXRADIX</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/system_tb/test_harness/dut/inst/adc_valid_i1">
      <obj_property name="ElementShortName">adc_valid_i1     (R2 I-channel valid — 0 in 1R1T)</obj_property>
      <obj_property name="ObjectShortName">adc_valid_i1     (R2 I-channel valid — 0 in 1R1T)</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/system_tb/test_harness/dut/inst/adc_data_i1">
      <obj_property name="ElementShortName">adc_data_i1[15:0]</obj_property>
      <obj_property name="ObjectShortName">adc_data_i1[15:0]</obj_property>
      <obj_property name="Radix">HEXRADIX</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/system_tb/test_harness/dut/inst/adc_valid_q1">
      <obj_property name="ElementShortName">adc_valid_q1     (R2 Q-channel valid — 0 in 1R1T)</obj_property>
      <obj_property name="ObjectShortName">adc_valid_q1     (R2 Q-channel valid — 0 in 1R1T)</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/system_tb/test_harness/dut/inst/adc_data_q1">
      <obj_property name="ElementShortName">adc_data_q1[15:0]</obj_property>
      <obj_property name="ObjectShortName">adc_data_q1[15:0]</obj_property>
      <obj_property name="Radix">HEXRADIX</obj_property>
   </wvobject>

   <!-- ================================================================ -->
   <!-- SECTION 3 divider                                                -->
   <!-- ================================================================ -->
   <wvobject fp_name="divider_sec3" type="divider">
      <obj_property name="label">── SECTION 3: Invalid/glitch patterns (7.326–10.158 us) ──</obj_property>
      <obj_property name="DisplayName">label</obj_property>
   </wvobject>

   <!-- ================================================================ -->
   <!-- TX Physical Interface (always running)                           -->
   <!-- ================================================================ -->
   <wvobject fp_name="divider_tx_phys" type="divider">
      <obj_property name="label">TX Physical (LVDS pins)</obj_property>
      <obj_property name="DisplayName">label</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/system_tb/test_harness/dut/inst/tx_frame_out_p">
      <obj_property name="ElementShortName">tx_frame_out_p</obj_property>
      <obj_property name="ObjectShortName">tx_frame_out_p</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/system_tb/test_harness/dut/inst/tx_data_out_p">
      <obj_property name="ElementShortName">tx_data_out_p[5:0]</obj_property>
      <obj_property name="ObjectShortName">tx_data_out_p[5:0]</obj_property>
      <obj_property name="Radix">HEXRADIX</obj_property>
   </wvobject>

   <!-- ================================================================ -->
   <!-- TX Serializer internals                                          -->
   <!-- ================================================================ -->
   <wvobject fp_name="divider_tx_ser" type="divider">
      <obj_property name="label">TX Serializer (inside lvds_if)</obj_property>
      <obj_property name="DisplayName">label</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/system_tb/test_harness/dut/inst/genblk2/i_dev_if/tx_data_sel">
      <obj_property name="ElementShortName">tx_data_sel[1:0] (slot counter 0-3)</obj_property>
      <obj_property name="ObjectShortName">tx_data_sel[1:0] (slot counter 0-3)</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/system_tb/test_harness/dut/inst/genblk2/i_dev_if/tx_frame_p">
      <obj_property name="ElementShortName">tx_frame_p</obj_property>
      <obj_property name="ObjectShortName">tx_frame_p</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/system_tb/test_harness/dut/inst/genblk2/i_dev_if/tx_data_0_p">
      <obj_property name="ElementShortName">tx_data_0_p[5:0] (I serialized)</obj_property>
      <obj_property name="ObjectShortName">tx_data_0_p[5:0] (I serialized)</obj_property>
      <obj_property name="Radix">HEXRADIX</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/system_tb/test_harness/dut/inst/genblk2/i_dev_if/tx_data_1_p">
      <obj_property name="ElementShortName">tx_data_1_p[5:0] (Q serialized)</obj_property>
      <obj_property name="ObjectShortName">tx_data_1_p[5:0] (Q serialized)</obj_property>
      <obj_property name="Radix">HEXRADIX</obj_property>
   </wvobject>

</wave_config>
